<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cr_retroactive_policy_list" model="ir.ui.view">
        <field name="name">cr.payroll.retroactive.rule.policy.list</field>
        <field name="model">cr.payroll.retroactive.rule.policy</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id"/>
                <field name="salary_rule_id"/>
                <field name="policy"/>
                <field name="active"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_cr_retroactive_policy_form" model="ir.ui.view">
        <field name="name">cr.payroll.retroactive.rule.policy.form</field>
        <field name="model">cr.payroll.retroactive.rule.policy</field>
        <field name="arch" type="xml">
            <form string="Política de recálculo retroactivo">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="salary_rule_id"/>
                        <field name="policy"/>
                        <field name="active"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cr_retroactive_policy" model="ir.actions.act_window">
        <field name="name">Políticas de recálculo retroactivo</field>
        <field name="res_model">cr.payroll.retroactive.rule.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

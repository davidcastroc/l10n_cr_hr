<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_cr_deduction_tree" model="ir.ui.view">
        <field name="name">cr.payroll.deduction.list</field>
        <field name="model">cr.payroll.deduction</field>

        <field name="arch" type="xml">
            <list>
                <field name="priority"/>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="deduction_type"/>
                <field name="calculation"/>

                <field
                    name="amount"
                    optional="show"
                />

                <field
                    name="percentage"
                    optional="hide"
                />

                <field
                    name="balance"
                    optional="show"
                />

                <field name="frequency"/>

                <field
                    name="application_moment"
                    optional="show"
                />

                <field name="date_from"/>

                <field
                    name="date_to"
                    optional="show"
                />

                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cr_deduction_form" model="ir.ui.view">
        <field name="name">cr.payroll.deduction.form</field>
        <field name="model">cr.payroll.deduction</field>

        <field name="arch" type="xml">
            <form string="Deducción recurrente">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field
                                name="name"
                                placeholder="Ej. Crédito Banco Popular"
                            />
                        </h1>
                    </div>

                    <group>

                        <group string="Información general">

                            <field name="employee_id"/>

                            <field name="deduction_type"/>

                            <field name="calculation"/>

                            <field
                                name="amount"
                                invisible="calculation != 'fixed'"
                            />

                            <field
                                name="percentage"
                                invisible="calculation != 'percent'"
                            />

                            <field name="currency_id" invisible="1"/>

                        </group>

                        <group string="Aplicación">

                            <field name="frequency"/>

                            <field
                                name="application_moment"
                                invisible="frequency != 'monthly'"
                            />

                            <field name="priority"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <group>

                        <group string="Vigencia">

                            <field name="date_from"/>

                            <field name="date_to"/>

                        </group>

                        <group string="Control de saldo">

                            <field name="original_amount"/>

                            <field name="balance"/>

                        </group>

                    </group>

                    <group string="Información legal o de referencia">

                        <group>

                            <field name="court_file"/>

                            <field name="beneficiary"/>

                        </group>

                    </group>

                    <group string="Observaciones">
                        <field
                            name="notes"
                            nolabel="1"
                            placeholder="Detalle, referencia o condición especial de la deducción..."
                        />
                    </group>

                    <notebook>

                        <page string="Movimientos">

                            <field
                                name="movement_ids"
                                nolabel="1"
                                readonly="1"
                            >
                                <list create="0" delete="0">

                                    <field name="date"/>

                                    <field name="payslip_id"/>

                                    <field name="amount"/>

                                    <field name="balance_before"/>

                                    <field name="balance_after"/>

                                    <field name="state"/>

                                </list>
                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <record id="action_cr_deduction" model="ir.actions.act_window">
        <field name="name">Deducciones recurrentes CR</field>
        <field name="res_model">cr.payroll.deduction</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>